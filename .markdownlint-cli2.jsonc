{
  "config": {
    "default": true,
    "MD012": false,
    "MD013": false,
    "MD024": {
      "siblings_only": true,
    },
    "MD025": false,
    "MD033": {
      "allowed_elements": ["br"],
    },
    "MD036": false,
  },
  "globs": ["*.md", "docs/**/*.md", "examples/**/*.md"],
  "ignores": ["node_modules/**", "dist/**", "coverage/**"],
}
