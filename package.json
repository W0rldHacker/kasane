{
  "name": "@worldhacker/kasane",
  "version": "1.0.0",
  "description": "Explainable layered configuration for Node.js and TypeScript.",
  "keywords": [
    "configuration",
    "environment",
    "esm",
    "nodejs",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/W0rldHacker/kasane.git"
  },
  "homepage": "https://github.com/W0rldHacker/kasane#readme",
  "bugs": {
    "url": "https://github.com/W0rldHacker/kasane/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.13.0",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./standard-schema": {
      "types": "./dist/standard-schema.d.ts",
      "import": "./dist/standard-schema.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "lint": "pnpm lint:code && pnpm lint:markdown",
    "lint:code": "pnpm build && pnpm exec tsc -p packages/source-testkit/tsconfig.build.json && pnpm exec tsc -p packages/watch/tsconfig.build.json && pnpm exec tsc -p packages/cli/tsconfig.build.json && eslint .",
    "lint:markdown": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "build:check": "pnpm build && node scripts/check-build.mjs",
    "api:check": "pnpm build && node scripts/check-public-api.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "node scripts/test-fuzz.mjs security",
    "test:fuzz": "node scripts/test-fuzz.mjs fuzz",
    "test:fuzz:nightly": "node scripts/test-fuzz.mjs fuzz --runs=100000 --timeout-ms=2700000",
    "test:property": "node scripts/test-property.mjs fast",
    "test:property:nightly": "node scripts/test-property.mjs nightly",
    "test:architecture": "vitest run --project architecture",
    "pack:check": "pnpm build && node scripts/check-build.mjs && node scripts/check-tarball.mjs",
    "test:package": "pnpm pack:check && node scripts/test-package.mjs && node scripts/test-consumers.mjs --packed && node scripts/test-upgrade.mjs --packed",
    "test:types": "pnpm build && node scripts/test-types.mjs && node scripts/check-public-api.mjs && node scripts/check-type-performance.mjs",
    "test:consumer": "pnpm test:consumer:packed",
    "test:consumer:registry": "node scripts/test-consumers.mjs --registry",
    "test:consumer:upgrade:packed": "pnpm pack:check && node scripts/test-upgrade.mjs --packed",
    "test:consumer:upgrade:registry": "node scripts/test-upgrade.mjs --registry",
    "test:consumer:packed": "pnpm pack:check && node scripts/test-consumers.mjs --packed",
    "test:packed": "pnpm test:consumer:packed",
    "docs:check": "node scripts/docs-check.mjs",
    "security:policy-check": "node scripts/security-policy-check.mjs",
    "maintenance:table": "node scripts/update-support-table.mjs",
    "maintenance:check": "node scripts/maintenance-policy-check.mjs",
    "maintenance:tabletop": "node scripts/maintenance-tabletop.mjs",
    "companion:policy-check": "node scripts/companion-policy-check.mjs",
    "companion:verify": "pnpm companion:policy-check && pnpm --filter @worldhacker/kasane-source-testkit typecheck && pnpm --filter kasane-companion-template typecheck && pnpm --filter @worldhacker/kasane-watch typecheck && pnpm --filter @worldhacker/kasane-cli typecheck && pnpm --filter @worldhacker/kasane-source-testkit test && pnpm --filter kasane-companion-template test && pnpm --filter @worldhacker/kasane-watch test && pnpm --filter @worldhacker/kasane-cli test",
    "post-004:policy-check": "node scripts/post-004-policy-check.mjs",
    "post-004:verify": "pnpm post-004:policy-check && pnpm --filter @kasane/post-004-experiments typecheck && pnpm --filter @kasane/post-004-experiments test",
    "post-004:bench": "pnpm --filter @kasane/post-004-experiments bench",
    "companion:release:pack": "node scripts/companion-release.mjs pack",
    "companion:release:rehearse": "node scripts/companion-release.mjs rehearse",
    "companion:release:publish": "node scripts/companion-release.mjs publish",
    "companion:release:bootstrap-publish": "node scripts/companion-release.mjs bootstrap-publish",
    "companion:release:published-check": "node scripts/companion-release.mjs published-check",
    "companion:release:registry-smoke": "node scripts/companion-release.mjs registry-smoke",
    "ci:policy-check": "node scripts/ci-policy-check.mjs",
    "changeset:check": "node scripts/changeset-check.mjs",
    "release:policy-check": "node scripts/release-policy-check.mjs",
    "release:version": "node scripts/release-version.mjs",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "release:rehearse": "node scripts/release-rehearse.mjs",
    "release:published-check": "node scripts/check-published-release.mjs",
    "release:publish": "node scripts/release-publish.mjs",
    "examples:test": "pnpm build && node scripts/test-examples.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "bench": "pnpm build && node --expose-gc scripts/bench.mjs",
    "bench:check": "pnpm bench && node scripts/check-benchmarks.mjs",
    "bench:compare": "pnpm bench && node scripts/check-benchmarks.mjs && node scripts/compare-benchmarks.mjs",
    "bench:ci": "pnpm bench:check",
    "changeset": "changeset",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm docs:check && pnpm security:policy-check && pnpm maintenance:check && pnpm companion:verify && pnpm post-004:verify && pnpm ci:policy-check && pnpm changeset:check && pnpm release:policy-check && pnpm architecture:check && pnpm build:check && pnpm examples:test && pnpm test:package && pnpm release:dry-run && pnpm release:rehearse && pnpm test && pnpm test:types"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "fast-check": "4.9.0",
    "globals": "17.7.0",
    "markdownlint-cli2": "0.23.0",
    "prettier": "3.9.5",
    "publint": "0.3.21",
    "tsd": "0.33.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "tsd": {
    "directory": "test/types"
  }
}
