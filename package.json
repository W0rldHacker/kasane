{
  "name": "kasane",
  "version": "0.0.0",
  "description": "Explainable layered configuration for Node.js and TypeScript.",
  "keywords": [
    "configuration",
    "environment",
    "esm",
    "nodejs",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/W0rldHacker/kasane.git"
  },
  "homepage": "https://github.com/W0rldHacker/kasane#readme",
  "bugs": {
    "url": "https://github.com/W0rldHacker/kasane/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.13.0",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./standard-schema": {
      "types": "./dist/standard-schema.d.ts",
      "import": "./dist/standard-schema.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "lint": "pnpm lint:code && pnpm lint:markdown",
    "lint:code": "eslint .",
    "lint:markdown": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "build:check": "pnpm build && node scripts/check-build.mjs",
    "api:check": "pnpm build && node scripts/check-public-api.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "node scripts/test-fuzz.mjs security",
    "test:fuzz": "node scripts/test-fuzz.mjs fuzz",
    "test:fuzz:nightly": "node scripts/test-fuzz.mjs fuzz --runs=100000 --timeout-ms=2700000",
    "test:property": "node scripts/test-property.mjs fast",
    "test:property:nightly": "node scripts/test-property.mjs nightly",
    "test:architecture": "vitest run --project architecture",
    "test:package": "pnpm build && node scripts/check-build.mjs && node scripts/test-package.mjs && node scripts/test-consumers.mjs && publint && attw --pack .",
    "test:types": "pnpm build && node scripts/test-types.mjs && node scripts/check-public-api.mjs && node scripts/check-type-performance.mjs",
    "test:consumer": "pnpm build && node scripts/test-consumers.mjs",
    "test:packed": "pnpm test:consumer",
    "docs:check": "node scripts/docs-check.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "bench": "pnpm build && node --expose-gc scripts/bench.mjs",
    "bench:check": "pnpm bench && node scripts/check-benchmarks.mjs",
    "bench:ci": "pnpm bench:check",
    "changeset": "changeset",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm docs:check && pnpm architecture:check && pnpm build:check && node scripts/test-package.mjs && node scripts/test-consumers.mjs && publint && attw --pack . && pnpm test && pnpm test:types"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "fast-check": "4.9.0",
    "globals": "17.7.0",
    "markdownlint-cli2": "0.23.0",
    "prettier": "3.9.5",
    "publint": "0.3.21",
    "tsd": "0.33.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  },
  "tsd": {
    "directory": "test/types"
  }
}
